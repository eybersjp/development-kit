{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-kit.dev/schemas/verification-extension.schema.json",
  "title": "Development Kit Verification Extension Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "name",
    "description",
    "version",
    "checkTypes",
    "referenceDatasets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "extensionId": {
      "type": "string",
      "pattern": "^ve-[a-zA-Z0-9_-]{3,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "checkTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "referenceDatasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
