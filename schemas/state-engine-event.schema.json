{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-kit.dev/schemas/state-engine-event.schema.json",
  "title": "Development Kit State Engine V2 Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "eventId",
    "timestamp",
    "actorClass",
    "eventType",
    "entityType",
    "entityId",
    "lifecycleId",
    "taskId",
    "contractId",
    "runId",
    "payload",
    "previousEventHash",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt-[0-9]{10}-[a-f0-9]{20}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actorClass": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
    },
    "entityType": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ]
    },
    "contractId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "previousEventHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
