{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-kit.dev/schemas/lifecycle-instance.schema.json",
  "title": "Development Kit Lifecycle Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lifecycleId",
    "parentLifecycleId",
    "type",
    "name",
    "stage",
    "status",
    "targets",
    "sourceRevision",
    "sourceFingerprint",
    "stateRevision",
    "acceptanceState",
    "acceptanceContractId",
    "acceptanceRunId",
    "acceptedAt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "lifecycleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "parentLifecycleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "UNDERSTAND",
        "DEFINE",
        "DESIGN",
        "PLAN",
        "IMPLEMENT",
        "VERIFY",
        "REVIEW",
        "SIMPLIFY",
        "COMPLETE"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "COMPLETE",
        "CANCELLED"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "uniqueItems": true
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 1
    },
    "acceptanceState": {
      "enum": [
        "PENDING",
        "ACCEPTED",
        "BLOCKED"
      ]
    },
    "acceptanceContractId": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptanceRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
