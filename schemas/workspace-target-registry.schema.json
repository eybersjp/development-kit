{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-kit.dev/schemas/workspace-target-registry.schema.json",
  "title": "Development Kit Workspace Target Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9@][A-Za-z0-9._:@/-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "dependencies",
          "commands",
          "capabilities",
          "verification",
          "adapter"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9@][A-Za-z0-9._:@/-]{0,127}$"
            },
            "uniqueItems": true
          },
          "commands": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "uniqueItems": true
          },
          "adapter": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
